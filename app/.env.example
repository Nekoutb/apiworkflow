# =========================================================
# API Cameroun — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =========================================================

# --- Database (PostgreSQL) ---
# Production: a PostgreSQL on AWS RDS in eu-west-3 (Paris).
# Local dev: docker run -d --name pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5432/apicameroun?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"

# --- Optional OAuth providers (investor convenience) ---
# Leave empty to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- Email (transactional) ---
# Choices: Resend, AWS SES, SendGrid. Set the matching block.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="API Cameroun <no-reply@api.cm>"

# --- S3-compatible storage for documents ---
S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"
S3_REGION="eu-west-3"
S3_BUCKET="apicm-docs-prod"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- App metadata ---
APP_NAME="API Cameroun"
APP_LOCALE_DEFAULT="fr"
APP_LOCALES="fr,en"

# --- Feature flags ---
FEATURE_OAUTH=false
FEATURE_2FA_REQUIRED_STAFF=true
FEATURE_2FA_REQUIRED_INVESTOR=false
