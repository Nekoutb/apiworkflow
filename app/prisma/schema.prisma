// =========================================================
// API Cameroun — Investment Incentives Portal
// Database schema (PostgreSQL via Prisma)
// Based on Ordonnance n° 2025/002 du 18 juillet 2025
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js required tables ---

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  name            String?
  image           String?
  // Discriminator: 'investor' or 'staff'
  userType        UserType
  // For staff: which workflow role
  staffRole       StaffRole?
  // 2FA
  totpSecret      String?
  totpEnabled     Boolean   @default(false)
  // Locale preference (overrides browser default)
  locale          String    @default("fr")
  // Account state
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // For investor users — link to the investor profile (1-1)
  investorProfile InvestorProfile?

  // Auth.js relations
  accounts        Account[]
  sessions        Session[]

  // Domain relations
  documentsVerified Document[]      @relation("DocumentVerifier")
  opinionsSigned    Opinion[]       @relation("OpinionSigner")
  historyEntries    HistoryEntry[]
  auditTrail        AuditTrailEntry[]
  notifications     Notification[]
  recoursesFiled    Recourse[]      @relation("RecourseFiledBy")

  @@index([userType])
  @@index([staffRole])
}

enum UserType {
  INVESTOR
  STAFF
}

// 5-stage workflow roles + system admin
// Stage 1: SECRETARY (Secrétariat — vérification de complétude)
// Stage 2: DIR_INVESTMENTS (Directeur des Investissements)
// Stage 3: DIR_COMPLIANCE (Directeur de la Conformité)
// Stage 4: DIR_EXTERNAL (Directeur des Relations Extérieures)
// Stage 5: DG (Directeur Général — signature finale)
// + ADMIN (gestion des comptes, configuration système)
enum StaffRole {
  SECRETARY
  DIR_INVESTMENTS
  DIR_COMPLIANCE
  DIR_EXTERNAL
  DG
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// --- Auth.js OAuth account linking ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain: Investor profile (extends User for investor type) ---
model InvestorProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  raisonSociale String
  niu           String? // Numéro d'Identifiant Unique (Cameroon tax ID)
  legalForm     String? // SARL, SA, SUARL, etc.
  country       String  @default("Cameroun")
  isResident    Boolean @default(true)
  contactPhone  String?

  // KYC / AML status (Art. 49)
  kycStatus     KycStatus @default(PENDING)
  kycCompletedAt DateTime?

  dossiers      Dossier[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

// --- Domain: Dossier (the investment-incentive request) ---
model Dossier {
  id                 String        @id @default(cuid())
  // Sequential ID in YYYY/NNNNNN format (e.g. 2025/000123)
  reference          String        @unique
  investorProfileId  String
  investorProfile    InvestorProfile @relation(fields: [investorProfileId], references: [id])

  regime             Regime        @default(COMMUN)
  projectType        ProjectType
  sector             Sector
  isZdp              Boolean       @default(false)
  zdpLocality        String?
  objet              String        @db.Text
  installationMonths Int           @default(60)

  // Investment amount in FCFA (BigInt because > 2^31 possible)
  amountFcfa         BigInt

  // Category derived from amountFcfa (A < 1Md, B 1-5Md, C > 5Md)
  category           Category

  // Lifecycle state
  state              DossierState  @default(DRAFT)

  // Key timestamps (statutory clocks)
  submittedAt        DateTime?
  recepisseAt        DateTime?
  recepisseNo        String?
  agreementSignedAt  DateTime?
  agreementNo        String?

  // Eligibility declarations (free-form JSON for Art. 7 / Art. 8 criteria)
  eligibilityJson    Json?

  // Relations
  documents          Document[]
  opinions           Opinion[]
  equipmentLists     EquipmentList[]
  annualReports      AnnualReport[]
  auditCases         AuditCase[]
  sanctions          Sanction[]
  recourses          Recourse[]
  history            HistoryEntry[]
  notifications      Notification[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([state])
  @@index([category])
  @@index([investorProfileId])
}

enum Regime {
  COMMUN       // Régime commun — convention d'investissement
  ZES          // Zone économique
  PPP          // Partenariat Public-Privé
  TRANSITOIRE  // Art. 47 migration from prior regime
}

enum ProjectType {
  NEW           // Projet nouveau (Art. 7)
  EXTENSION     // Projet d'extension (Art. 8)
  MIGRATION     // Art. 47
}

enum Sector {
  AGRICULTURE  // Agriculture, élevage, pêche (Art. 3.1.a)
  INDUSTRIE    // Industrie lourde, automobile, manufacturière (Art. 3.1.b)
  ENERGIE      // Eau et énergie (Art. 3.1.c)
  EDUCATION    // Éducation et santé (Art. 3.1.d)
  TRANSPORT    // Transport aérien, ferroviaire, maritime (Art. 3.1.e)
  TOURISME     // Tourisme et loisirs (Art. 3.1.f)
  DISTRIBUTION // Infrastructures de grande distribution (Art. 3.1.g)
  NUMERIQUE    // Infrastructures stockage/traitement données (Art. 3.1.h)
}

enum Category {
  A  // < 1 Md FCFA
  B  // 1–5 Md FCFA
  C  // > 5 Md FCFA
}

enum DossierState {
  DRAFT                    // Investor still preparing
  SUBMITTED                // Filed, pending document verification
  DOCS_VERIFICATION        // Reception checking each piece
  RECEIPT_ISSUED           // Récépissé delivered, clock starts (Art. 30.3)
  INSTRUCTION_DONE         // Technical instruction complete
  TAX_OPINION_DONE         // DGI avis émis
  CUSTOMS_OPINION_DONE     // DGD avis émis
  SYNTHESIS_DONE           // Chef GU validated
  ACCREDITED               // DG signed convention
  REJECTED                 // Rejected at some stage
  RETURNED                 // Returned to investor for completion
  SUSPENDED                // Incentives suspended (Art. 41)
  WITHDRAWN                // Incentives withdrawn (Art. 37)
}

// --- Domain: Documents (uploaded by investor, verified by reception) ---
model Document {
  id              String  @id @default(cuid())
  dossierId       String
  dossier         Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  // Document kind (constrained to the fixed Art. 6 list — enforced in app code)
  kind            DocumentKind
  fileName        String
  storageUri      String  // s3:// path
  sha256          String
  sizeBytes       Int
  mimeType        String

  uploadedAt      DateTime @default(now())

  // Verification flow at Reception
  verification    VerificationState @default(PENDING)
  verifiedByUserId String?
  verifiedBy      User?    @relation("DocumentVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?  @db.Text

  @@index([dossierId])
  @@index([verification])
}

enum DocumentKind {
  ACTIVITY_AUTHORIZATION  // Autorisation d'exercice (Art. 6.1)
  RECRUITMENT_PLAN        // Plan de recrutement Camerounais (Art. 6.2.a)
  TECH_TRANSFER_PLAN      // Plan de transfert de technologies (Art. 6.2.a)
  LOCAL_SUBCONTRACTING    // Plan de sous-traitance locale (Art. 6.2.a)
  FINANCING_PROOF         // Justification du financement (Art. 6.2.b)
  FEASIBILITY             // Étude de faisabilité (Art. 6)
  // Additional supporting documents
  EQUIPMENT_LIST          // Liste prévisionnelle équipements (Art. 33)
  ANNUAL_REPORT           // Rapport annuel (Art. 32)
  OTHER
}

enum VerificationState {
  PENDING
  ACCEPTED
  REJECTED
}

// --- Domain: Opinions (Avis) ---
model Opinion {
  id              String       @id @default(cuid())
  dossierId       String
  dossier         Dossier      @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  admin           AdminBody
  phase           OpinionPhase
  position        OpinionPosition
  reasoning       String       @db.Text

  signerUserId    String
  signer          User         @relation("OpinionSigner", fields: [signerUserId], references: [id])
  signedAt        DateTime     @default(now())

  @@index([dossierId])
  @@index([admin])
}

enum AdminBody {
  INSTRUCTION  // Service Technique
  TAX          // DGI
  CUSTOMS      // DGD
  TECHNICAL    // Other technical administration (sector-specific)
}

enum OpinionPhase {
  CONVENTION           // Initial convention signing
  EQUIPMENT_LIST       // Equipment list validation (Art. 33)
  EXTENSION_REQUEST    // Time extension request (Art. 36)
  AUDIT                // Audit case
}

enum OpinionPosition {
  FAVORABLE
  FAVORABLE_WITH_RESERVE
  UNFAVORABLE
}

// --- Domain: Equipment list (Art. 33) ---
model EquipmentList {
  id           String   @id @default(cuid())
  dossierId    String
  dossier      Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  phase        String   // 'installation' | 'exploitation'
  itemsJson    Json     // [{ qty, hsCode, description, unitValueFcfa, ... }]
  validatedAt  DateTime?
  validatedByUserId String?

  createdAt    DateTime @default(now())
}

// --- Domain: Annual reports (Art. 32) ---
model AnnualReport {
  id              String   @id @default(cuid())
  dossierId       String
  dossier         Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  fiscalYear      Int      // e.g. 2026
  submittedAt     DateTime?
  isLate          Boolean  @default(false)
  lateMonths      Int      @default(0)
  // Fine accrual: 1 M FCFA / month of delay (Art. 32.3)
  fineAccruedFcfa BigInt   @default(0)
  contentJson     Json?

  @@unique([dossierId, fiscalYear])
  @@index([fiscalYear])
}

// --- Domain: Audit cases (Comité d'audit, Art. 39) ---
model AuditCase {
  id            String    @id @default(cuid())
  dossierId     String
  dossier       Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  trigger       String    // 'annual_report' | 'comite_initiative' | 'dg_request'
  startedAt     DateTime  @default(now())
  closedAt      DateTime?
  outcome       String?   // 'CONFORM' | 'NON_CONFORM'
  findingsJson  Json?
}

// --- Domain: Sanctions (Art. 41) ---
model Sanction {
  id              String     @id @default(cuid())
  dossierId       String
  dossier         Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  kind            SanctionKind
  // Fine amount per Art. 41.3 schedule (10/15/25 M FCFA by category)
  amountFcfa      BigInt?
  startDate       DateTime?
  endDate         DateTime?   // null for non-time-bound sanctions
  pvUri           String?     // procès-verbal URI
  miseEnDemeureAt DateTime?
  appliedAt       DateTime?
  reason          String      @db.Text

  createdAt       DateTime    @default(now())
}

enum SanctionKind {
  ABANDONED
  FINE
  SUSPENSION   // Max 6 months (Art. 41.3)
  WITHDRAWAL   // Withdraws agreement; triggers fiscal/customs recovery
}

// --- Domain: Recourse (Art. 40) ---
model Recourse {
  id              String   @id @default(cuid())
  dossierId       String
  dossier         Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  filedByUserId   String
  filedBy         User     @relation("RecourseFiledBy", fields: [filedByUserId], references: [id])
  filedAt         DateTime @default(now())
  subject         String   @db.Text
  state           String   // 'AMIABLE' | 'CLOSED_AMIABLE' | 'ESCALATED'
  // 30-day clock (Art. 40.2)
  amiableDueAt    DateTime?
  closedAt        DateTime?
  outcomeJson     Json?
}

// --- Domain: History (per-dossier event log, user-facing) ---
model HistoryEntry {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  comment     String?  @db.Text
  // Used for UI styling (e.g. 'return', 'reject', 'sign')
  cssClass    String?

  createdAt   DateTime @default(now())

  @@index([dossierId])
  @@index([createdAt])
}

// --- Domain: Notifications ---
model Notification {
  id          String   @id @default(cuid())
  forUserId   String
  forUser     User     @relation(fields: [forUserId], references: [id], onDelete: Cascade)

  dossierId   String?
  dossier     Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  icon        String
  iconClass   String
  title       String   @db.Text
  body        String?  @db.Text
  read        Boolean  @default(false)
  emailedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([forUserId, read])
  @@index([createdAt])
}

// --- Audit trail: append-only, every action that touches sensitive data ---
// SHA-256 chain enforced in application layer
model AuditTrailEntry {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])

  entityType  String   // 'dossier' | 'document' | 'opinion' | 'user' | etc.
  entityId    String
  action      String   // 'create' | 'update' | 'sign' | 'verify' | 'read_sensitive' | etc.
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  prevHash    String?  // sha256 of previous entry — tamper evidence
  hash        String   // sha256 of this entry

  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}

// --- Reference data (configurable) ---
model ZdpLocality {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model BusinessHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  label     String
  createdAt DateTime @default(now())
}
