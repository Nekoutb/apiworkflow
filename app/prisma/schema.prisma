// =========================================================
// API Cameroun — Investment Incentives Portal
// Prisma schema (PostgreSQL via Neon)
//
// Domain model for the 5-stage internal workflow:
//   SECRETARY → DIR_INVESTMENTS → DIR_COMPLIANCE → DIR_EXTERNAL → DG
//
// Every convention is owned by exactly one investor, accumulates
// documents (each with comments), and is advanced through stages
// by WorkflowEvent rows.  AI analyses and financial summaries are
// cached per stage so we never re-call Claude unnecessarily.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Auth.js tables
// ---------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?

  userType      UserType
  staffRole     StaffRole?

  locale        String     @default("fr")
  status        UserStatus @default(ACTIVE)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Domain relations
  investor               Investor?
  documentsVerified      Document[]            @relation("DocumentVerifier")
  workflowEventsActioned WorkflowEvent[]       @relation("WorkflowActor")
  conventionsSigned      Convention[]          @relation("ConventionSigner")
  conventionsImported    Convention[]          @relation("ConventionImporter")
  commentsAuthored       Comment[]
  notifications          Notification[]
  auditTrail             AuditTrailEntry[]

  @@index([userType])
  @@index([staffRole])
}

enum UserType {
  INVESTOR
  STAFF
}

// 5-stage workflow roles + system admin.
enum StaffRole {
  SECRETARY
  DIR_INVESTMENTS
  DIR_COMPLIANCE
  DIR_EXTERNAL
  DG
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------
// Investor (the company behind every dossier)
// ---------------------------------------------------------

model Investor {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  raisonSociale String
  niu           String? // Numéro d'Identifiant Unique (Cameroon tax ID)
  legalForm     String? // SARL, SA, SUARL, GIE, etc.
  country       String  @default("Cameroun")
  region        String?
  city          String?
  address       String?

  contactName   String?
  contactPhone  String?

  // True for investors whose conventions pre-date this website and were
  // imported manually (Activity A20).
  isExisting    Boolean @default(false)

  conventions   Convention[]
  annualReports AnnualReport[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isExisting])
}

// ---------------------------------------------------------
// Convention — the investment-incentive dossier
// ---------------------------------------------------------

model Convention {
  id          String   @id @default(cuid())
  reference   String   @unique // e.g. CV-2026-000123

  investorId  String
  investor    Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  // Project descriptors
  projectName String
  sector      Sector
  region      String?
  projectType ProjectType @default(NEW)

  // Financials
  investmentFcfa BigInt
  jobsPlanned    Int      @default(0)
  category       Category // A/B/C derived from investmentFcfa

  // Lifecycle
  status       ConventionStatus @default(DRAFT)
  currentStage ConventionStage  @default(SECRETARY)

  // Key timestamps
  submittedAt DateTime?  // when investor submitted the dossier
  recepisseAt DateTime?  // when Secrétariat issued the récépissé — starts the 10-day clock (Art. 30.3)
  signedAt    DateTime?  // when DG signed the convention
  closedAt    DateTime?

  // Reference numbers issued along the way
  recepisseNo String?    // récépissé number, set when recepisseAt is set
  agreementNo String?    // convention number, set when signedAt is set

  // Who issued the récépissé (Secrétariat user)
  recepisseUserId String?

  // DG who signed the final convention
  signerUserId String?
  signer       User?    @relation("ConventionSigner", fields: [signerUserId], references: [id])

  // Import bookkeeping (for pre-website conventions, A20)
  isImported       Boolean   @default(false)
  importedAt       DateTime?
  importedByUserId String?
  importedBy       User?     @relation("ConventionImporter", fields: [importedByUserId], references: [id])
  scannedOriginalUri String?  // PDF of the paper convention, when imported

  // Cached AI outputs (one financial summary, several stage analyses)
  financialSummary FinancialSummary?
  aiAnalyses       AiAnalysis[]

  // Children
  documents      Document[]
  workflowEvents WorkflowEvent[]
  comments       Comment[]
  notifications  Notification[]

  // Post-signature submissions (Art. 32, 33, 34, 36, 48)
  equipmentList       EquipmentList?
  annualReports       AnnualReport[]
  royaltyPayments     RoyaltyPayment[]
  extensionRequests   ExtensionRequest[]
  attestationRequest  AttestationRequest?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([currentStage])
  @@index([investorId])
  @@index([isImported])
}

enum ConventionStatus {
  DRAFT          // investor still filling out / uploading
  SUBMITTED      // in workflow
  RETURNED       // bounced back to investor for completion
  REJECTED       // rejected at some stage
  SIGNED         // DG signed
  CLOSED         // archived after signing
}

enum ConventionStage {
  SECRETARY
  DIR_INVESTMENTS
  DIR_COMPLIANCE
  DIR_EXTERNAL
  DG
}

enum ProjectType {
  NEW       // Projet nouveau (Art. 7)
  EXTENSION // Projet d'extension (Art. 8)
}

enum Sector {
  AGRICULTURE     // Agriculture, élevage, pêche
  INDUSTRIE       // Industrie lourde, automobile, manufacturière
  ENERGIE         // Eau et énergie
  EDUCATION_SANTE // Éducation et santé
  TRANSPORT       // Transport aérien, ferroviaire, maritime
  TOURISME        // Tourisme et loisirs
  DISTRIBUTION    // Infrastructures de grande distribution
  NUMERIQUE       // Infrastructures stockage/traitement données
}

enum Category {
  A // < 1 Md FCFA
  B // 1–5 Md FCFA
  C // > 5 Md FCFA
}

// ---------------------------------------------------------
// Document (uploaded by investor, verified by Secrétariat)
// ---------------------------------------------------------

model Document {
  id           String     @id @default(cuid())
  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  kind       DocumentKind
  fileName   String
  storageUri String       // Vercel Blob URL (or local path during dev)
  sha256     String
  sizeBytes  Int
  mimeType   String
  pageCount  Int?

  // OCR / extracted text (cached output from AI step)
  ocrText        String?   @db.Text
  ocrCompletedAt DateTime?

  // Verification by Secretariat
  verification     VerificationState @default(PENDING)
  verifiedByUserId String?
  verifiedBy       User?              @relation("DocumentVerifier", fields: [verifiedByUserId], references: [id])
  verifiedAt       DateTime?
  rejectionReason  String?            @db.Text

  uploadedAt DateTime @default(now())

  comments    Comment[]
  aiAnalyses  AiAnalysis[]

  @@index([conventionId])
  @@index([verification])
  @@index([kind])
}

enum DocumentKind {
  // Mandatory document set (Investment Code, Art. 6)
  REGISTRATION       // RCCM (Registre du Commerce et du Crédit Mobilier)
  TAX_ID             // Attestation NIU
  NON_REDEVANCE      // Attestation de non-redevance fiscale
  COMPANY_STATUTES   // Statuts de la société
  FEASIBILITY_STUDY  // Étude de faisabilité
  FINANCING_PROOF    // Justification du financement
  // Supporting documents
  RECRUITMENT_PLAN     // Plan de recrutement camerounais
  TECH_TRANSFER_PLAN   // Plan de transfert de technologies
  LOCAL_SUBCONTRACTING // Plan de sous-traitance locale
  ENVIRONMENTAL_STUDY  // Étude d'impact environnemental
  ACTIVITY_AUTHORIZATION // Autorisation d'exercer
  ANNUAL_REPORT          // Rapport annuel (Art. 32, post-signature)
  OTHER
}

enum VerificationState {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------------------------------------------------------
// WorkflowEvent — append-only log of stage transitions
// ---------------------------------------------------------

model WorkflowEvent {
  id           String     @id @default(cuid())
  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  stage  ConventionStage
  action WorkflowAction

  actorUserId String?
  actor       User?   @relation("WorkflowActor", fields: [actorUserId], references: [id])

  comment String? @db.Text

  // SLA bookkeeping — true after the 72h reminder has been sent for this
  // particular RECEIVED event (avoids duplicate reminders).
  reminderSent Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([conventionId, createdAt])
  @@index([stage])
  @@index([action])
}

// Each stage emits the same shape of events.
enum WorkflowAction {
  RECEIVED        // arrived at this stage
  RECEIPT_ISSUED  // récépissé de dépôt délivré — only emitted at SECRETARY stage; starts the 10-day clock (Art. 30.3)
  SIGNED_OFF      // current director signed off (review complete)
  HANDED_OFF      // transferred to the next stage
  RETURNED        // sent back to investor for completion
  REJECTED        // rejected at this stage
}

// ---------------------------------------------------------
// Comment — polymorphic: attached to a Document OR a Convention
// ---------------------------------------------------------

model Comment {
  id String @id @default(cuid())

  // Exactly one of these is set.
  conventionId String?
  convention   Convention? @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation(fields: [authorUserId], references: [id])

  body String @db.Text

  // Threading (optional)
  parentCommentId String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([conventionId])
}

// ---------------------------------------------------------
// AI analyses (cached Claude outputs per stage)
// ---------------------------------------------------------

model AiAnalysis {
  id String @id @default(cuid())

  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  // Optional document focus (null => convention-level analysis)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  stage ConventionStage  // which director was looking at the time
  kind  AiAnalysisKind

  // Free-form structured output from Claude
  summary    String  @db.Text
  contentJson Json?

  // Token / cost bookkeeping
  modelName       String?
  tokensIn        Int?
  tokensOut       Int?

  generatedAt DateTime @default(now())

  @@index([conventionId, stage])
  @@index([documentId])
  @@index([kind])
}

enum AiAnalysisKind {
  OCR_EXTRACTION       // Plain OCR of a scanned document
  COMPLIANCE_FORM      // Conformité en la forme (Secrétariat / DIR_INVESTMENTS)
  COMPLIANCE_SUBSTANCE // Conformité au fond (DIR_COMPLIANCE)
  EXTERNAL_REGS_CHECK  // Réglementations externes (DIR_EXTERNAL)
  EXECUTIVE_SUMMARY    // Résumé exécutif pour DG
  FINANCIAL_EXTRACT    // Used by FinancialSummary
}

// ---------------------------------------------------------
// FinancialSummary (1 per convention, AI-extracted)
// ---------------------------------------------------------

model FinancialSummary {
  id           String     @id @default(cuid())
  conventionId String     @unique
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  // Aggregates extracted by the AI from feasibility + financing docs
  totalInvestmentFcfa BigInt?
  equityFcfa          BigInt?
  debtFcfa            BigInt?
  capexFcfa           BigInt?
  opexYearOneFcfa     BigInt?
  expectedRevenueFcfa BigInt?
  paybackMonths       Int?

  jobsDirect   Int?
  jobsIndirect Int?

  detailJson Json? // raw structured extraction (table rows, currencies, etc.)

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Notification (in-app + email queue)
// ---------------------------------------------------------

model Notification {
  id        String @id @default(cuid())
  forUserId String
  forUser   User   @relation(fields: [forUserId], references: [id], onDelete: Cascade)

  conventionId String?
  convention   Convention? @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String?  @db.Text
  link  String?

  read       Boolean   @default(false)
  emailed    Boolean   @default(false)
  emailedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([forUserId, read])
  @@index([createdAt])
}

enum NotificationKind {
  CONVENTION_SUBMITTED
  DOCUMENT_INCOMPLETE
  STAGE_RECEIVED
  STAGE_HANDOFF
  STAGE_DELAY_REMINDER // 72h SLA reminder
  CONVENTION_SIGNED
  CONVENTION_REJECTED
  CONVENTION_RETURNED
  CONVENTION_CLOSED
  COMMENT_ADDED
}

// ---------------------------------------------------------
// Post-signature submissions (Art. 32, 33, 34, 36, 48)
// ---------------------------------------------------------

// Art. 32 — annual report on investment execution.
model AnnualReport {
  id           String     @id @default(cuid())
  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  investorId   String
  investor     Investor   @relation(fields: [investorId], references: [id], onDelete: Cascade)

  fiscalYear  Int
  submittedAt DateTime  @default(now())
  submittedByUserId String?

  // Performance vs commitments
  jobsActual          Int?
  investmentActualFcfa BigInt?
  exportsActualFcfa    BigInt?
  localPurchasesFcfa   BigInt?

  // Free-form narrative
  notes        String?  @db.Text

  // Optional supporting PDF
  attachmentUri String?

  // SLA bookkeeping — late = 1 M FCFA / month (Art. 32.3)
  isLate          Boolean @default(false)
  monthsLate      Int     @default(0)
  fineAccruedFcfa BigInt  @default(0)

  status SubmissionStatus @default(PENDING)

  @@unique([conventionId, fiscalYear])
  @@index([investorId])
  @@index([fiscalYear])
}

// Art. 33 — equipment list, one-off, validated jointly by API + DGD.
model EquipmentList {
  id           String     @id @default(cuid())
  conventionId String     @unique
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  submittedAt DateTime @default(now())
  submittedByUserId String?

  // [{ description, qty, hsCode, unitValueFcfa, ... }]
  itemsJson      Json
  totalValueFcfa BigInt

  attachmentUri String?
  status SubmissionStatus @default(PENDING)
}

// Art. 48 — annual royalty (0.1 %, plancher 100 k, plafond 5 M FCFA).
model RoyaltyPayment {
  id           String     @id @default(cuid())
  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  fiscalYear     Int
  amountDueFcfa  BigInt
  amountPaidFcfa BigInt?
  paidAt         DateTime?
  proofUri       String?

  status SubmissionStatus @default(PENDING)
  createdAt DateTime @default(now())

  @@unique([conventionId, fiscalYear])
}

// Art. 36 — extension of installation / exploitation deadlines.
model ExtensionRequest {
  id           String     @id @default(cuid())
  conventionId String
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  reason          String   @db.Text
  requestedMonths Int      // capped at 24 (Art. 36.3)
  attachmentUri   String?

  submittedAt DateTime @default(now())
  submittedByUserId String?

  status SubmissionStatus @default(PENDING)
  decidedAt DateTime?
  decisionNotes String? @db.Text
}

// Art. 34 — attestation de réalisation (one per convention).
model AttestationRequest {
  id           String     @id @default(cuid())
  conventionId String     @unique
  convention   Convention @relation(fields: [conventionId], references: [id], onDelete: Cascade)

  expectedCompletionDate DateTime
  notes                  String? @db.Text
  attachmentUri          String?

  submittedAt DateTime @default(now())
  submittedByUserId String?

  inspectionScheduledAt DateTime?
  status SubmissionStatus @default(PENDING)
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID    // for royalties
}

// ---------------------------------------------------------
// AuditTrail (security log — every sensitive action)
// ---------------------------------------------------------

model AuditTrailEntry {
  id          String  @id @default(cuid())
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  entityType String // 'convention' | 'document' | 'user' | etc.
  entityId   String
  action     String // 'create' | 'update' | 'sign' | 'verify' | etc.
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?

  // Tamper-evidence chain (set in app layer)
  prevHash String?
  hash     String

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}
