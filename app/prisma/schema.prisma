// =========================================================
// API Cameroun — Document Workflow · Schema v2
// Document-centric · organigramme-aware
// Adopted 2026-05-24 (re-baseline)
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Auth.js core
// ---------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  image         String?

  userType      UserType   @default(STAFF)
  staffRole     StaffRole?

  // Optional binding to an antenna (Chef d'Antenne and antenna staff)
  antenneId     String?
  antenne       Antenne?   @relation("AntenneStaff", fields: [antenneId], references: [id])

  locale        String     @default("fr")
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  // Auth.js
  accounts      Account[]
  sessions      Session[]

  // Document workflow relations
  assignmentsAssigned   Assignment[]           @relation("AssignedTo")
  assignmentsAssignedBy Assignment[]           @relation("AssignedBy")
  handoffsFrom          Handoff[]              @relation("HandoffFrom")
  handoffsTo            Handoff[]              @relation("HandoffTo")
  comments              Comment[]
  attachments           Attachment[]
  versionsUploaded      DocumentVersion[]      @relation("VersionUploader")
  submissionsRegistered Submission[]           @relation("RegisteredBy")
  notifications         Notification[]
  auditTrail            AuditTrailEntry[]
  externalSent          ExternalTransmission[] @relation("ExtSentBy")
  antennesAsChef        Antenne[]              @relation("AntenneChef")

  @@index([userType])
  @@index([staffRole])
}

enum UserType {
  STAFF    // API personnel
  EXTERNAL // External submitter (investor, partner, citizen, other admin)
}

// 37 organigramme roles + ADMIN.
// Order = top-down per Résolution du 02 juillet 2020.
enum StaffRole {
  // --- Direction Générale (Art. 1)
  DG
  DGA

  // --- Auprès du DG
  ATTACHE                  // Art. 3
  AUDITEUR_INTERNE         // Art. 4

  // --- Sous-direction Communication (Art. 5-7)
  CHEF_SOUSDIR_COMM
  CHEF_SERVICE_COMM
  CHEF_SERVICE_RP

  // --- Cellule Traduction (Art. 8)
  CHEF_CELL_TRAD

  // --- Sous-direction Affaires Générales (Art. 9-13)
  CHEF_SOUSDIR_AG
  CHEF_SERVICE_SAF
  CHEF_SERVICE_RH
  CHEF_SERVICE_INFO
  CHEF_SERVICE_MATERIEL

  // --- Affaires Juridiques (Art. 14)
  CHEF_SERVICE_JUR

  // --- Service du Courrier (Art. 15-18)
  CHEF_SERVICE_COURRIER
  CHEF_BUREAU_ARRIVEE
  CHEF_BUREAU_DEPART
  CHEF_BUREAU_ARCHIVES

  // --- Direction Promotion (Art. 20-29)
  DIR_PROMOTION
  CHEF_SOUSDIR_LOCALE
  CHEF_SERVICE_PRIMAIRE
  CHEF_SERVICE_SECONDAIRE
  CHEF_SERVICE_TERTIAIRE
  CHEF_SOUSDIR_ETRANGER
  CHEF_SERVICE_EUROPE
  CHEF_SERVICE_AMERIQUE
  CHEF_SERVICE_MOAP
  CHEF_SERVICE_AFRIQUE

  // --- Direction Facilitation (Art. 30-36)
  DIR_FACILITATION
  CHEF_SOUSDIR_FACILITATION
  CHEF_SERVICE_ACCUEIL
  CHEF_SERVICE_AGREMENTS
  CHEF_SOUSDIR_COOPERATION
  CHEF_SERVICE_BILATERALE
  CHEF_SERVICE_MULTILATERALE

  // --- Division Suivi-Évaluation (Art. 37-39)
  CHEF_DIV_SUIVI
  CHEF_CELL_SUIVI_EVAL
  CHEF_CELL_STRATEGIE

  // --- Antennes (Art. 41)
  CHEF_ANTENNE

  // --- Administration système
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------
// Antenne (regional offices · Art. 41-44)
// ---------------------------------------------------------

model Antenne {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Antenne Littoral"
  region      String              // e.g. "Littoral"
  ville       String?
  address     String?

  chefUserId  String?
  chef        User?    @relation("AntenneChef", fields: [chefUserId], references: [id])

  active      Boolean  @default(true)

  staff       User[]       @relation("AntenneStaff")
  submissions Submission[]
  documents   Document[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------
// Document — the central entity
// ---------------------------------------------------------

model Document {
  id                  String         @id @default(cuid())
  reference           String         @unique // COURRIER-YYYY-NNNNNN
  subject             String
  nature              DocumentNature @default(GENERAL_CORRESPONDENCE)
  status              DocumentStatus @default(RECEIVED)

  // Current location in workflow
  currentHolderRole   StaffRole?
  currentHolderUserId String?

  // Key timestamps
  submittedAt    DateTime  @default(now())
  acknowledgedAt DateTime?
  dispatchedAt   DateTime?
  decidedAt      DateTime?
  responseSentAt DateTime?
  closedAt       DateTime?

  // Source channel
  sourceChannel SourceChannel
  antenneId     String?
  antenne       Antenne? @relation(fields: [antenneId], references: [id])

  // Children
  submission            Submission?
  versions              DocumentVersion[]
  assignments           Assignment[]
  handoffs              Handoff[]
  comments              Comment[]
  attachments           Attachment[]
  aiAnalyses            AiAnalysis[]
  notifications         Notification[]
  externalTransmissions ExternalTransmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currentHolderRole])
  @@index([currentHolderUserId])
}

enum DocumentNature {
  AGREMENT_REQUEST       // demande d'agrément (Ordonnance 2025/002)
  GENERAL_CORRESPONDENCE // correspondance générale
  OFFICIAL_NOTIFICATION  // notification officielle d'une administration
  PARTNERSHIP_PROPOSAL   // proposition de partenariat
  COMPLAINT              // réclamation
  REPORT                 // rapport (annuel ou autre)
  OTHER
}

enum DocumentStatus {
  RECEIVED               // arrivé au Courrier · accusé envoyé
  AWAITING_DG_ANALYSIS   // chez DG · attente analyse IA + dispatch
  ASSIGNED               // affecté à une unité · attente prise en charge
  IN_TREATMENT           // traitement en cours
  AWAITING_EXTERNAL_AVIS // transmis externe · attente retour
  AWAITING_DG_DECISION   // traité · renvoyé au DG pour décision
  DECIDED                // décision DG prise · attente expédition
  RESPONSE_SENT          // réponse expédiée à l'émetteur
  CLOSED                 // dossier clos · archivé
  AWAITING_FOLLOW_UP     // ouvert · attente complément émetteur
}

enum SourceChannel {
  ONLINE            // soumis via /submit
  COURRIER_PHYSICAL // déposé au siège · scanné par Bureau Arrivée
  ANTENNE           // déposé à une antenne · scanné · transmis
}

// ---------------------------------------------------------
// Submission — initial entry record
// ---------------------------------------------------------

model Submission {
  id         String   @id @default(cuid())
  documentId String   @unique
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Émetteur info (free-form, no account required)
  senderName         String
  senderEmail        String
  senderOrganization String?
  senderPhone        String?
  senderAddress      String?
  senderType         String? // "Investisseur" · "Administration" · "Citoyen" · etc.

  // Channel
  submittedVia SourceChannel
  antenneId    String?
  antenne      Antenne? @relation(fields: [antenneId], references: [id])

  // Registration
  registeredAt       DateTime @default(now())
  registeredByUserId String?
  registeredBy       User?    @relation("RegisteredBy", fields: [registeredByUserId], references: [id])

  // Acknowledgement
  acknowledgementSentAt DateTime?
  acknowledgementCode   String? // tracking code (also = document.reference)

  @@index([senderEmail])
  @@index([acknowledgementCode])
}

// ---------------------------------------------------------
// DocumentVersion — physical / digital files
// ---------------------------------------------------------

model DocumentVersion {
  id         String              @id @default(cuid())
  documentId String
  document   Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind       DocumentVersionKind
  fileName   String
  storageUri String
  sha256     String
  sizeBytes  Int
  mimeType   String
  pageCount  Int?

  // OCR cache
  ocrText        String?   @db.Text
  ocrCompletedAt DateTime?

  uploadedAt       DateTime @default(now())
  uploadedByUserId String?
  uploadedBy       User?    @relation("VersionUploader", fields: [uploadedByUserId], references: [id])

  @@index([documentId])
}

enum DocumentVersionKind {
  ORIGINAL       // soumis tel quel par l'émetteur (en ligne)
  SCANNED        // scan d'un courrier physique
  COMPLEMENT     // pièce complémentaire ajoutée par l'émetteur
  RESPONSE_DRAFT // brouillon de réponse du DG
  RESPONSE_FINAL // réponse signée et expédiée
  EXTERNAL_AVIS  // avis reçu d'un destinataire externe
}

// ---------------------------------------------------------
// Assignment — current ownership snapshot
// ---------------------------------------------------------

model Assignment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  assignedToRole   StaffRole
  assignedToUserId String?
  assignedTo       User?     @relation("AssignedTo", fields: [assignedToUserId], references: [id])

  assignedByUserId String?
  assignedBy       User?    @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt       DateTime @default(now())

  instructions String? @db.Text

  status      AssignmentStatus @default(ACTIVE)
  completedAt DateTime?

  @@index([documentId, status])
  @@index([assignedToUserId])
  @@index([assignedToRole])
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  RETURNED
  SUPERSEDED // when reassigned (e.g. handoff)
}

// ---------------------------------------------------------
// Handoff — append-only transfer log
// ---------------------------------------------------------

model Handoff {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type HandoffType

  fromRole   StaffRole?
  fromUserId String?
  fromUser   User?      @relation("HandoffFrom", fields: [fromUserId], references: [id])

  toRole   StaffRole?
  toUserId String?
  toUser   User?      @relation("HandoffTo", fields: [toUserId], references: [id])

  reason String? @db.Text

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([type])
}

enum HandoffType {
  COURRIER_TO_DG // Bureau Arrivée → DG
  DG_DISPATCH    // DG → unit (after analysis)
  VERTICAL_DOWN  // Director → Sous-dir → Service → Bureau
  HORIZONTAL     // Director → other Director
  RETURN_UP      // Subordinate → supervisor
  RETURN_TO_DG   // Direction → DG after treatment
  EXTERNAL_OUT   // External advisory request
  EXTERNAL_IN    // External avis received
  DG_TO_COURRIER // DG → Bureau Départ (response)
  RESPONSE_OUT   // Bureau Départ → émetteur
}

// ---------------------------------------------------------
// Comment — discussion thread per document
// ---------------------------------------------------------

model Comment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User      @relation(fields: [authorUserId], references: [id])
  authorRole   StaffRole?

  body String @db.Text

  parentCommentId String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, createdAt])
}

// ---------------------------------------------------------
// Attachment — pieces added during treatment
// ---------------------------------------------------------

model Attachment {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName   String
  storageUri String
  sha256     String
  sizeBytes  Int
  mimeType   String

  kind AttachmentKind @default(NOTE_INTERNAL)

  addedByUserId String?
  addedBy       User?      @relation(fields: [addedByUserId], references: [id])
  addedByRole   StaffRole?

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
}

enum AttachmentKind {
  NOTE_INTERNAL  // note interne ajoutée par un agent
  AVIS           // avis formel d'une unité
  DECISION_DRAFT // brouillon de décision DG
  EXTERNAL_AVIS  // avis externe reçu
  RESPONSE_DRAFT // brouillon de réponse à l'émetteur
  OTHER
}

// ---------------------------------------------------------
// AiAnalysis — Claude outputs (cached)
// ---------------------------------------------------------

model AiAnalysis {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind AiAnalysisKind

  summary     String @db.Text
  contentJson Json?

  modelName String?
  tokensIn  Int?
  tokensOut Int?

  generatedAt DateTime @default(now())

  @@index([documentId, kind])
}

enum AiAnalysisKind {
  OCR_EXTRACTION        // texte brut OCR
  EXECUTIVE_SUMMARY     // résumé exécutif pour le DG (3-5 phrases)
  ASSIGNMENT_SUGGESTION // suggestion d'affectation à une unité
  EXTERNAL_AVIS_SUMMARY // résumé d'un avis externe reçu
  CLASSIFICATION        // classification générale du document
}

// ---------------------------------------------------------
// Notification — in-app + email queue
// ---------------------------------------------------------

model Notification {
  id        String @id @default(cuid())
  forUserId String
  forUser   User   @relation(fields: [forUserId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  kind  NotificationKind
  title String
  body  String?  @db.Text
  link  String?

  read      Boolean   @default(false)
  emailed   Boolean   @default(false)
  emailedAt DateTime?

  createdAt DateTime @default(now())

  @@index([forUserId, read])
  @@index([createdAt])
}

enum NotificationKind {
  DOCUMENT_RECEIVED      // pour Bureau Arrivée
  DOCUMENT_ASSIGNED      // pour destinataire d'un dispatch DG
  DOCUMENT_RETURNED_UP   // pour supérieur quand subordonné renvoie
  DOCUMENT_HORIZONTAL    // pour autre Directeur (+ DG)
  DOCUMENT_TO_DG         // pour DG quand renvoyé après traitement
  DG_DECISION_MADE       // pour Bureau Départ
  EXTERNAL_AVIS_RECEIVED // pour destinataire original
  RESPONSE_SENT          // pour DG quand expédié
  ACK_SENT               // pour Bureau Arrivée
  COMMENT_ADDED          // pour hiérarchie + destinataire
}

// ---------------------------------------------------------
// ExternalTransmission (Min. Finances etc. · Art. 30)
// ---------------------------------------------------------

model ExternalTransmission {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  recipient        ExternalRecipient
  recipientName    String? // free-form when AUTRE
  recipientEmail   String?
  recipientAddress String?

  purpose String @db.Text

  sentAt       DateTime @default(now())
  sentByUserId String
  sentBy       User     @relation("ExtSentBy", fields: [sentByUserId], references: [id])

  expectedReturnAt DateTime?

  // Response
  receivedAt        DateTime?
  opinionStorageUri String?
  opinionSummary    String?   @db.Text

  status ExternalTransmissionStatus @default(PENDING)

  @@index([documentId])
  @@index([status])
}

enum ExternalRecipient {
  MINISTRE_FINANCES
  MINISTRE_INDUSTRIE
  DGI
  DGD
  MINISTRE_AUTRE
  ADMINISTRATION_AUTRE
}

enum ExternalTransmissionStatus {
  PENDING
  RESPONSE_RECEIVED
  CANCELLED
}

// ---------------------------------------------------------
// AuditTrail (chain-of-custody)
// ---------------------------------------------------------

model AuditTrailEntry {
  id          String  @id @default(cuid())
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  entityType String // 'document' | 'assignment' | 'handoff' | etc.
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  ip         String?
  userAgent  String?
  prevHash   String?
  hash       String

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}
